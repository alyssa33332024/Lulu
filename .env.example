# 复制为仓库根目录 .env 后填入真实值（.env 勿提交 Git）

# --- 大脑 ---
DATABASE_URL=sqlite:///./data/lulu.db

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-2-0-mini-260428
ARK_CHAT_FAST_MODEL=doubao-seed-2-0-mini-260428
CHAT_DRAFT_BACKEND=ark
CHAT_AGENT_BACKEND=ark
CHAT_FAST_OLLAMA_MODEL=qwen2.5:3b
ARK_EMBEDDING_MODEL=
OLLAMA_EMBEDDING_MODEL=
DRAFT_TIMEOUT_MS=8000

SPEECH_API_KEY=
SPEECH_APP_ID=
SPEECH_APP_KEY=
SPEECH_ASR_APP_ID=
SPEECH_ASR_ACCESS_TOKEN=
SPEECH_TTS_APP_ID=
SPEECH_TTS_ACCESS_TOKEN=
SPEECH_SECRET_KEY=

TTS_RESOURCE_ID=seed-tts-2.0
ASR_RESOURCE_ID=volc.seedasr.sauc.duration
TTS_SPEAKER=saturn_zh_female_tiaopigongzhu_tob
TTS_ENABLED=true
ASR_ENABLED=true
TTS_CLUSTER=volcano_tts
SPEECH_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional

RTC_APP_ID=
RTC_APP_KEY=

CUSTOM_LLM_API_KEY=lulu-custom-llm-local
CUSTOM_LLM_PUBLIC_URL=http://127.0.0.1:8000

VOICEPRINT_ENABLED=false
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

INTENT_MODEL_BACKEND=ark_json
INTENT_MODEL_NAME=mindbridge-qwen2.5-7b-ft
OLLAMA_HOST=http://127.0.0.1:11434

SOLE_MEMBER_FALLBACK=true
FORCE_CARD_ID=

MEMORY_BACKEND=akashic
AKASHIC_CONTEXT_WINDOW=128000
CONTEXT_KEEP_RECENT_TOKENS=20000
CONTEXT_MAX_OUTPUT_TOKENS=4096
AKASHIC_OPTIMIZER_ON_COMPRESS=false
AKASHIC_OPTIMIZER_ENABLED=true
AKASHIC_OPTIMIZER_INTERVAL_SECONDS=64800

# --- 门户 ---
PORT=3920
